{
  "name": "@thallesp/nestjs-better-auth",
  "version": "1.0.2",
  "description": "Better Auth for NestJS",
  "author": "Thalles Passos",
  "license": "MIT",
  "repository": "https://github.com/thallesp/nestjs-better-auth",
  "keywords": [
    "nestjs",
    "better-auth",
    "auth",
    "nestjs-better-auth"
  ],
  "scripts": {
    "build": "bunup src/index.ts --format esm,cjs --dts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "dev:express": "bun run examples/express-example.ts",
    "dev:fastify": "bun run examples/fastify-example.ts",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tsconfig/node22": "^22.0.2",
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@nestjs/testing": "^11.0.0",
    "bunup": "^0.8.37",
    "@nestjs/platform-fastify": "^11.0.0",
    "better-auth": "^1.2.8",
    "sqlite3": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": "^5",
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "better-auth": "^1.2.8",
    "express": "^5.0.0",
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/platform-fastify": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}
